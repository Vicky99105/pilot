# Copy to .env and fill in real values. Never commit .env.
# Used by: docker compose --env-file .env -f deploy/docker-compose.yml up -d

# Postgres superuser, shared by the app and Temporal in Phase 0.
# Use URL-safe characters only: the password is embedded in DATABASE_URL.
POSTGRES_USER=claims
POSTGRES_PASSWORD=replace-with-a-long-random-string

# Temporal
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=claims

# Caddy site address: the server IP now, the domain later.
SITE_ADDRESS=203.0.113.10

# Backend settings when running uvicorn on the host (outside Docker).
# Inside compose, the app service receives these from deploy/docker-compose.yml.
DATABASE_URL=postgresql+psycopg://claims:replace-with-a-long-random-string@localhost:5432/claims
TEMPORAL_ADDRESS=localhost:7233
# Relative to backend/, where uvicorn runs.
UI_DIST_DIR=../ui/dist
